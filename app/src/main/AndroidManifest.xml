<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:horizonos="http://schemas.horizonos/sdk">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="com.oculus.permission.USE_SCENE" />

    <uses-feature android:name="android.hardware.vr.headtracking" android:required="true" />
    <uses-feature android:name="com.oculus.feature.BOUNDARYLESS_APP" android:required="true" />
    <uses-feature android:name="com.oculus.feature.PASSTHROUGH" android:required="false" />
    <uses-feature android:name="com.oculus.feature.VIRTUAL_KEYBOARD" android:required="false" />
    <uses-feature android:name="oculus.software.overlay_keyboard" android:required="false" />
    <uses-feature android:glEsVersion="0x00030001" />

    <horizonos:uses-horizonos-sdk
        horizonos:minSdkVersion="69"
        horizonos:targetSdkVersion="69" />

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:label="GeoGebraForQuest"
        android:largeHeap="true"
        android:usesCleartextTraffic="false">

        <meta-data
            android:name="com.oculus.supportedDevices"
            android:value="quest3|questpro|quest2" />
        <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />
        <meta-data
            android:name="com.oculus.ossplash.background"
            android:value="passthrough-contextual" />

        <uses-native-library android:name="libossdk.oculus.so" android:required="true" />

        <!--
          v0.4.0: single-activity architecture.
          The app is spatial from launch, but visually presents one flat GeoGebra
          panel in passthrough. The 3D Graphics rectangle alone becomes spatial
          stereo when the replacement Anaglyph/headset option is selected.
        -->
        <activity
            android:name=".SpatialGeoGebraActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:launchMode="singleTask"
            android:excludeFromRecents="false"
            android:configChanges="screenSize|screenLayout|orientation|keyboardHidden|keyboard|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Kept only as a non-launcher fallback for development/recovery. -->
        <activity
            android:name=".PancakeActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:theme="@style/PanelAppTheme" />
    </application>
</manifest>
