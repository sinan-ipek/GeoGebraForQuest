<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:horizonos="http://schemas.horizonos/sdk">

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.hardware.vr.headtracking" android:required="true" />
    <uses-feature android:name="com.oculus.feature.PASSTHROUGH" android:required="false" />
    <uses-feature android:name="com.oculus.feature.VIRTUAL_KEYBOARD" android:required="false" />
    <uses-feature android:name="oculus.software.overlay_keyboard" android:required="false" />
    <uses-feature android:glEsVersion="0x00030001" />

    <horizonos:uses-horizonos-sdk
        horizonos:minSdkVersion="69"
        horizonos:targetSdkVersion="69" />

    <application
        android:allowBackup="false"
        android:label="GeoGebraForQuest"
        android:largeHeap="true"
        android:usesCleartextTraffic="false">

        <meta-data
            android:name="com.oculus.supportedDevices"
            android:value="quest3|questpro|quest2" />
        <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />
        <meta-data
            android:name="com.oculus.ossplash.background"
            android:value="passthrough-contextual" />

        <uses-native-library android:name="libossdk.oculus.so" android:required="true" />

        <!--
          Start exactly like the Meta HybridSample: a normal Horizon OS 2D panel.
          This is the path already proven to launch GeoGebra correctly on Quest.
        -->
        <activity
            android:name=".PancakeActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:theme="@style/PanelAppTheme">
            <layout android:defaultHeight="720dp" android:defaultWidth="1080dp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="com.oculus.intent.category.2D" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Entered only after the replacement Anaglyph/Quest Stereo control is selected.
          It visually recreates the same GeoGebra panel in passthrough and reveals native
          stereo only through the existing 3D Graphics viewport.
        -->
        <activity
            android:name=".SpatialGeoGebraActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:launchMode="singleTask"
            android:excludeFromRecents="false"
            android:configChanges="screenSize|screenLayout|orientation|keyboardHidden|keyboard|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="com.oculus.intent.category.VR" />
            </intent-filter>
        </activity>
    </application>
</manifest>
